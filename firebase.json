{
    "firestore": {
        "database": "(default)",
        "location": "nam5",
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "functions": [
        {
            "source": "functions",
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ],
            "disallowLegacyRuntimeConfig": true,
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local"
            ]
        }
    ],
    "hosting": {

        "public": "frontend/dist",
        "predeploy": [
            "node scripts/build-frontend.cjs"
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            },
            {
                "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "/api/health",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/landingMetrics",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/analyzeImage",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/createTicket",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/buildingInfo",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/checkAuth",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/submitAppFeedback",
                "function": {
                    "functionId": "residentApi",
                    "region": "us-central1"
                }
            },
            {
                "source": "/api/getResidentTickets",
                "function": {
