rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // RFQ attachments and contractor quotes (max 6MB per file, safe document & media types only)
    match /tenants/{tenantId}/rfqs/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.resource.size < 6 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'application/msword'
            || request.resource.contentType.matches('application/vnd\\.openxmlformats-officedocument\\..*')
            || request.resource.contentType == 'application/vnd.ms-excel'
            || request.resource.contentType == 'application/octet-stream');
      allow delete: if true;
    }

    // General tenant storage
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback rule for authenticated users
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}